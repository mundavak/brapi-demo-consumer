{
  "architecture": {
    "description": "Bookmap Broadcasting API (BrAPI) consumer/provider architecture with dual-storage (Redis + TimescaleDB)",
    "data_sources": [
      {
        "name": "Bookmap Core Platform",
        "type": "Java Application",
        "role": "Host environment and data source",
        "description": "Bookmap runs as the main application with real-time market data feeds"
      },
      {
        "name": "BrAPI Provider Modules",
        "type": "Bookmap Plugins/Addons",
        "role": "Data providers",
        "modules": [
          "Absorption Indicator (v4.52)",
          "Stops & Icebergs On-Chart",
          "Sweep Indicator",
          "Market Pulse"
        ],
        "location": "providers/modules/*.jar",
        "description": "Pre-compiled provider addons that broadcast trading events to consumer addons"
      }
    ],
    "consumer_addons": [
      {
        "name": "MboDataConsumer",
        "provider": "Built-in Bookmap MBO feed",
        "description": "Consumes Market-By-Order data directly from Bookmap (order-level data)",
        "file": "src/main/java/com/bookmap/demo/consumer/MboDataConsumer.java"
      },
      {
        "name": "StopsIcebergsConsumer",
        "provider": "SIT_INDICATOR (Stops & Icebergs On-Chart)",
        "description": "Detects stop hunts and hidden iceberg orders using MBO data",
        "file": "src/main/java/com/bookmap/demo/consumer/StopsIcebergsConsumer.java"
      },
      {
        "name": "AbsorptionConsumer",
        "provider": "ABSORPTION_INDICATOR",
        "description": "Tracks absorption events (aggressive orders absorbed by resting liquidity) and sweeps",
        "file": "src/main/java/com/bookmap/demo/consumer/AbsorptionConsumer.java"
      },
      {
        "name": "SweepsConsumer",
        "provider": "SWEEP_INDICATOR",
        "description": "Detects liquidity sweeps (aggressive orders clearing multiple price levels)",
        "file": "src/main/java/com/bookmap/demo/consumer/SweepsConsumer.java"
      },
      {
        "name": "OhlcCandleConsumer",
        "provider": "Built-in Bookmap OHLC aggregation",
        "description": "Aggregates tick data into OHLC candlesticks (1m, 5m, 15m, 1h, 4h, 1d)",
        "file": "src/main/java/com/bookmap/demo/consumer/OhlcCandleConsumer.java"
      },
      {
        "name": "MarketPulseConsumer",
        "provider": "MARKET_PULSE",
        "description": "Tracks market momentum and sentiment shifts",
        "file": "src/main/java/com/bookmap/demo/consumer/MarketPulseConsumer.java"
      },
      {
        "name": "LiquidityMarkerConsumer",
        "provider": "LIQUIDITY_MARKERS",
        "description": "Identifies significant support/resistance levels based on liquidity concentration",
        "file": "src/main/java/com/bookmap/demo/consumer/LiquidityMarkerConsumer.java"
      }
    ]
  },
  "data_flow": {
    "overview": "Real-time trading data flows from Bookmap → BrAPI Providers → Consumer Addons → Redis (hot) + TimescaleDB (cold)",
    "stages": [
      {
        "stage": 1,
        "name": "Event Generation",
        "location": "Bookmap Core + Provider Modules",
        "description": "Bookmap receives tick data from exchanges, provider modules analyze patterns and generate events"
      },
      {
        "stage": 2,
        "name": "Broadcasting",
        "location": "BroadcastFactory.getBroadcasterConsumer()",
        "description": "Provider modules broadcast events via BrAPI to subscribed consumer addons",
        "technology": "In-process Java event system (not network-based)"
      },
      {
        "stage": 3,
        "name": "Event Listeners",
        "location": "Consumer addon event handlers",
        "description": "Consumer addons implement LiveEventListener to receive real-time events",
        "examples": [
          "onStopEvent() - Handles stop hunt detections",
          "onIcebergEvent() - Handles iceberg order detections",
          "onAbsorptionEvent() - Handles absorption events",
          "onMboEvent() - Handles order book updates"
        ]
      },
      {
        "stage": 4,
        "name": "Hot Storage (Redis)",
        "location": "RedisManager.getInstance()",
        "description": "Immediate write to Redis for real-time dashboard queries",
        "pattern": "Synchronous write on event receipt",
        "ttl": "Configurable TTL per data type (default: 24h-48h)"
      },
      {
        "stage": 5,
        "name": "Batch Queuing",
        "location": "BlockingQueue<Event> batchQueue",
        "description": "Events queued for batched TimescaleDB writes",
        "queue_size": 5000,
        "pattern": "Non-blocking put_nowait() to avoid slowing main thread"
      },
      {
        "stage": 6,
        "name": "Cold Storage (TimescaleDB)",
        "location": "TimescaleDBManager.getInstance()",
        "description": "Batched writes to PostgreSQL/TimescaleDB for historical analysis",
        "pattern": "Scheduled batch processing every 5 seconds",
        "batch_size": 500
      }
    ]
  },
  "storage_architecture": {
    "redis": {
      "role": "Hot storage - real-time queries",
      "host": "localhost:6379",
      "technology": "Redis Stack (includes RedisJSON, RedisSearch, RedisTimeSeries)",
      "deployment": "Docker container (bookmap-redis-stack)",
      "manager_class": "com.bookmap.demo.consumer.database.RedisManager",
      "connection_pooling": "JedisPool with HikariCP-like configuration",
      "data_structures": {
        "sorted_sets": {
          "description": "Time-series data sorted by timestamp or price",
          "keys": [
            "mbo:{symbol}:{sessionId} - MBO events sorted by timestamp",
            "mbo:orders:{symbol}:bid - Bid orders sorted by price",
            "mbo:orders:{symbol}:ask - Ask orders sorted by price",
            "stop:{symbol}:session - Stop events sorted by timestamp",
            "iceberg:{symbol}:session - Iceberg events sorted by timestamp",
            "absorption:{symbol}:{cbdrWindow} - Absorption events sorted by significance",
            "sweep:{symbol}:{side} - Sweep events sorted by price",
            "liquidity:{symbol}:{levelType} - Liquidity levels sorted by price"
          ]
        },
        "streams": {
          "description": "Redis Streams for real-time event notifications",
          "keys": [
            "mbo:trades:{symbol} - Trade executions stream",
            "stream:stops_icebergs:{symbol} - Stop/iceberg detections stream",
            "stream:absorption:{symbol} - Absorption events stream",
            "stream:sweep:{symbol} - Sweep events stream",
            "stream:liquidity:{symbol} - Liquidity level changes stream"
          ],
          "maxlen": "500-1000 (approximate trimming)"
        },
        "hashes": {
          "description": "Current state snapshots",
          "keys": [
            "mbo:depth:{symbol}:bid - Current bid ladder (price -> size)",
            "mbo:depth:{symbol}:ask - Current ask ladder (price -> size)",
            "mbo:stats:{symbol} - Statistics (event counts, session info)",
            "candle:{symbol}:{timeframe}:current - Current candle in progress",
            "ladder:{symbol}:bid - Price ladder bid side",
            "ladder:{symbol}:ask - Price ladder ask side"
          ]
        }
      },
      "ttl_configuration": {
        "mbo": "86400 seconds (24 hours)",
        "ohlc_1m": "86400 seconds (24 hours)",
        "stops_icebergs": "86400 seconds (24 hours)",
        "absorption": "43200 seconds (12 hours)",
        "cbdr": "28800 seconds (8 hours)",
        "bias": "3600 seconds (1 hour)",
        "dashboard": "30 seconds",
        "config_file": "F:/Databases/database_config.properties"
      }
    },
    "timescaledb": {
      "role": "Cold storage - historical analysis",
      "host": "localhost:5432",
      "database": "trading_data",
      "technology": "TimescaleDB (PostgreSQL 17 extension)",
      "deployment": "Docker container (bookmap-timescaledb)",
      "manager_class": "com.bookmap.demo.consumer.database.TimescaleDBManager",
      "connection_pooling": "HikariCP (max 20 connections)",
      "tables": [
        {
          "table_name": "mbo_data",
          "description": "Market-By-Order data (order-level book updates)",
          "hypertable": true,
          "partitioning": "Time-based (automatic by TimescaleDB)",
          "primary_key": ["timestamp", "symbol", "order_id"],
          "indexes": [
            "mbo_data_timestamp_idx (timestamp DESC)",
            "idx_mbo_symbol_time (symbol, timestamp DESC)",
            "idx_mbo_price (symbol, price, timestamp DESC)",
            "idx_mbo_session (session_id, timestamp DESC)",
            "idx_mbo_cbdr (symbol, cbdr_window, timestamp DESC)",
            "idx_mbo_data_type (data_type)",
            "idx_mbo_data_symbol_type_timestamp (symbol, data_type, timestamp DESC)",
            "idx_mbo_additional_data_gin (additional_data GIN)"
          ],
          "columns": [
            {"name": "timestamp", "type": "timestamptz", "nullable": false, "description": "Event timestamp in EST/EDT timezone"},
            {"name": "symbol", "type": "varchar(20)", "nullable": false, "description": "Trading symbol (e.g., MNQZ5.CME@RITHMIC)"},
            {"name": "order_id", "type": "bigint", "nullable": false, "description": "Unique order identifier"},
            {"name": "side", "type": "varchar(4)", "nullable": false, "check": "BUY, SELL, N/A", "description": "Order side"},
            {"name": "price", "type": "double precision", "nullable": false, "description": "Order price level"},
            {"name": "size", "type": "bigint", "nullable": false, "description": "Order size (contracts/shares)"},
            {"name": "order_type", "type": "varchar(20)", "nullable": true, "description": "Order type (LIMIT, MARKET, etc.)"},
            {"name": "action", "type": "varchar(10)", "nullable": false, "check": "ADD, MODIFY, UPDATE, DELETE, EXECUTE, TRADE, DEPTH", "description": "Order action type"},
            {"name": "session_id", "type": "varchar(100)", "nullable": false, "description": "Trading session identifier (format: {symbol}_{yyyyMMdd_HHmmss}_{UUID})"},
            {"name": "cbdr_window", "type": "varchar(20)", "nullable": true, "description": "CBDR trading window (London, NewYork, Asian, Extended)"},
            {"name": "metadata", "type": "jsonb", "nullable": true, "description": "Additional metadata as JSON"},
            {"name": "additional_data", "type": "jsonb", "nullable": true, "description": "Complete JSON dump of all MBO event fields not captured in dedicated columns"},
            {"name": "data_type", "type": "varchar(20)", "nullable": true, "default": "MBO", "description": "Type of market data: MBO (order-level), TRADE (execution), or DEPTH (aggregated level)"}
          ],
          "current_symbols": ["MNQZ5.CME", "MNQZ5.CME@RITHMIC"],
          "record_count_approx": "5,184,137 (as of Nov 11, 2025)",
          "latest_data": "2025-11-11 14:04:17 EST"
        },
