  "batch_processing": {
    "description": "TimescaleDB writes use batch processing to avoid blocking real-time event handlers",
    "pattern": "Producer-Consumer with BlockingQueue",
    "queue": {
      "type": "LinkedBlockingQueue",
      "capacity": 5000,
      "blocking": false,
      "operation": "put_nowait() to avoid blocking main event thread"
    },
    "processor": {
      "type": "ScheduledExecutorService",
      "threads": 1,
      "schedule": "Fixed rate every 5 seconds",
      "batch_size": 500
    },
    "example": "batchProcessor.scheduleAtFixedRate(this::processBatch, 5, 5, TimeUnit.SECONDS)"
  },
