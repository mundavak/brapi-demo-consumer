          "partitioning": "Time-based (automatic by TimescaleDB)",
          "primary_key": ["timestamp", "symbol", "timeframe"],
          "indexes": [
            "ohlc_candles_timestamp_idx (timestamp DESC)",
            "idx_ohlc_symbol_tf_time (symbol, timeframe, timestamp DESC)",
            "idx_ohlc_session (session_id, timeframe, timestamp DESC)",
            "idx_ohlc_cbdr (symbol, cbdr_window, timestamp DESC)",
            "idx_ohlc_additional_data_gin (additional_data GIN)"
          ],
          "columns": [
            {"name": "timestamp", "type": "timestamptz", "nullable": false, "description": "Candle start time in EST/EDT timezone"},
            {"name": "symbol", "type": "varchar(20)", "nullable": false, "description": "Trading symbol"},
            {"name": "timeframe", "type": "varchar(10)", "nullable": false, "check": "1m, 5m, 15m, 1h, 4h, 1d", "description": "Candle timeframe"},
            {"name": "open", "type": "double precision", "nullable": false, "description": "Opening price"},
