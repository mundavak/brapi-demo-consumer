{
  "manifest_version": 3,
  "name": "Chart Data Helper",
  "version": "1.0.0",
  "description": "Personal chart analysis helper for trading research",
  "permissions": [
    "storage",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "*://www.tradingview.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.tradingview.com/chart/*"
      ],
      "js": [
        "content.js",
        "lightweight-monitor.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [],
  "externally_connectable": {
    "matches": []
  }
}