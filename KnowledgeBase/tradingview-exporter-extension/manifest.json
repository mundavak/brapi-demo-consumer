{
  "name": "TradingView Exporter",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "tabs",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.tradingview.com/chart/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}